---

<Layout>
	<div id="gate" class="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title">
		<div class="gate-card">
			<img class="gate-photo" src="/fernando.jpg" alt="Fernando Paz" width="112" height="112" />
			<h1 id="gate-title" data-i18n="gateTitle">{copy.en.gateTitle}</h1>
			<p data-i18n="gateText">{copy.en.gateText}</p>
			<button type="button" id="enter-btn" class="btn primary" data-i18n="gateBtn" onclick="window.__openPortfolio && window.__openPortfolio()">{copy.en.gateBtn}</button>
		</div>
	</div>

	<div id="site" class="site is-hidden" hidden>
		<header class="topbar">
			<div class="topbar-inner">
				<a class="logo" href="#home">Fernando Paz</a>
				<nav class="nav" aria-label="Primary">
					<a href="#home" data-i18n="navHome">{copy.en.navHome}</a>
					<a href="#about" data-i18n="navAbout">{copy.en.navAbout}</a>
					<a href="#skills" data-i18n="navSkills">{copy.en.navSkills}</a>
					<a href="#experience" data-i18n="navExperience">{copy.en.navExperience}</a>
					<a href="#projects" data-i18n="navProjects">{copy.en.navProjects}</a>
					<a href="#education" data-i18n="navEducation">{copy.en.navEducation}</a>
					<a href="#contact" data-i18n="navContact">{copy.en.navContact}</a>
				</nav>
				<div class="lang" role="group" aria-label="Language">
					<button type="button" data-lang="en" class="lang-btn is-active">EN</button>
					<button type="button" data-lang="es" class="lang-btn">ES</button>
				</div>
			</div>
		</header>

		<main>
			<section class="hero" id="home">
				<div class="hero-copy">
					<p class="hello" data-i18n="hello">{copy.en.hello}</p>
					<h1 data-i18n="name">{copy.en.name}</h1>
					<p class="role" data-i18n="role">{copy.en.role}</p>
					<p class="bio" data-i18n="heroBio">{copy.en.heroBio}</p>
					<div class="cta">
						<a class="btn primary" href="#contact" data-i18n="ctaTouch">{copy.en.ctaTouch}</a>
						<a class="btn ghost" href="#projects" data-i18n="ctaWork">{copy.en.ctaWork}</a>
					</div>
					<div class="social">
						<a href="mailto:fernandollanespaz@gmail.com" aria-label="Email" title="Email">
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5L4 8V6l8 5 8-5v2z"/></svg>
						</a>
						<a href="https://github.com/FerPazAutomation" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .5A11.5 11.5 0 0 0 .5 12.4c0 5.25 3.4 9.7 8.12 11.27.6.1.82-.26.82-.58v-2.03c-3.3.72-4-1.4-4-1.4-.54-1.38-1.32-1.75-1.32-1.75-1.08-.74.08-.72.08-.72 1.2.08 1.83 1.24 1.83 1.24 1.06 1.83 2.78 1.3 3.46.99.1-.78.42-1.3.76-1.6-2.64-.3-5.42-1.34-5.42-5.96 0-1.32.46-2.4 1.23-3.24-.12-.3-.53-1.52.12-3.17 0 0 1-.33 3.3 1.23a11.3 11.3 0 0 1 6 0c2.3-1.56 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.92 1.23 3.24 0 4.63-2.79 5.65-5.45 5.95.43.38.81 1.12.81 2.26v3.35c0 .32.22.7.83.58A11.5 11.5 0 0 0 23.5 12.4 11.5 11.5 0 0 0 12 .5z"/></svg>
						</a>
						<a href="https://www.linkedin.com/in/fernandollanespaz/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
								<path
									fill="currentColor"
									d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.23 0z"
								></path>
							</svg>
						</a>
					</div>
				</div>
				<div class="hero-photo-wrap">
					<div class="photo-ring" aria-hidden="true"></div>
					<img class="hero-photo" src="/fernando.jpg" alt="Fernando Paz" width="320" height="320" />
				</div>
			</section>

			<section class="section" id="about">
				<h2 data-i18n="aboutTitle">{copy.en.aboutTitle}</h2>
				<div class="about-card">
					<h3 data-i18n="aboutHeadline">{copy.en.aboutHeadline}</h3>
					<p data-i18n="aboutP1">{copy.en.aboutP1}</p>
					<p data-i18n="aboutP2">{copy.en.aboutP2}</p>
