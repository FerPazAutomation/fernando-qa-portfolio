			</section>

			<section class="section" id="experience">
				<h2 data-i18n="experienceTitle">{copy.en.experienceTitle}</h2>
				<div class="jobs" id="jobs"></div>
			</section>

			<section class="section" id="projects">
				<h2 data-i18n="projectsTitle">{copy.en.projectsTitle}</h2>
				<div class="projects" id="projects-grid"></div>
			</section>

			<section class="section" id="education">
				<h2 data-i18n="educationTitle">{copy.en.educationTitle}</h2>
				<ul class="education" id="education-list"></ul>
			</section>

			<section class="section contact" id="contact">
