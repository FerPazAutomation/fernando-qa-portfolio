				<div class="contact-card">
					<h3 data-i18n="contactHeadline">{copy.en.contactHeadline}</h3>
					<p data-i18n="contactText">{copy.en.contactText}</p>
					<div class="contact-links">
						<div>
							<span data-i18n="contactEmailLabel">{copy.en.contactEmailLabel}</span>
							<a href="mailto:fernandollanespaz@gmail.com">fernandollanespaz@gmail.com</a>
						</div>
						<div>
							<span data-i18n="contactPhoneLabel">{copy.en.contactPhoneLabel}</span>
							<strong data-i18n="contactPhone">{copy.en.contactPhone}</strong>
						</div>
						<div>
							<span data-i18n="contactLinkedinLabel">{copy.en.contactLinkedinLabel}</span>
							<a href="https://www.linkedin.com/in/fernandollanespaz/" target="_blank" rel="noopener noreferrer"
								>linkedin.com/in/fernandollanespaz</a
							>
						</div>
						<div>
							<span data-i18n="contactGithubLabel">{copy.en.contactGithubLabel}</span>
							<a href="https://github.com/FerPazAutomation" target="_blank" rel="noopener noreferrer"
								>github.com/FerPazAutomation</a
							>
						</div>
						<div>
							<span data-i18n="contactLocationLabel">{copy.en.contactLocationLabel}</span>
							<strong data-i18n="contactLocation">{copy.en.contactLocation}</strong>
						</div>
					</div>
					<div class="cv-block">
						<h4 data-i18n="cvTitle">{copy.en.cvTitle}</h4>
						<div class="cv-links">
							<a class="cv-btn" href="/cv/FernandoPaz-QA-ES.pdf" download data-i18n="cvEs">{copy.en.cvEs}</a>
							<a class="cv-btn" href="/cv/Fernando-QA-EN.pdf" download data-i18n="cvEn">{copy.en.cvEn}</a>
							<a class="cv-btn ghost" href="/cv/FernandoPaz-QA-ES-ATS.pdf" download data-i18n="cvEsAts">{copy.en.cvEsAts}</a>
							<a class="cv-btn ghost" href="/cv/Fernando-QA-EN-ATS.pdf" download data-i18n="cvEnAts">{copy.en.cvEnAts}</a>
