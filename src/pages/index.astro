</Layout>

<script type="application/json" id="portfolio-copy" set:html={JSON.stringify(copy)}></script>

<script is:inline>
	const copy = JSON.parse(document.getElementById("portfolio-copy").textContent);
	const gate = document.getElementById("gate");
	const site = document.getElementById("site");
	const enterBtn = document.getElementById("enter-btn");
	const langButtons = [...document.querySelectorAll(".lang-btn")];

	function setText(key, value) {
		document.querySelectorAll(`[data-i18n="${key}"]`).forEach((el) => {
			el.textContent = value;
		});
	}

	function render(lang) {
		const t = copy[lang] || copy.en;

		[
			"gateTitle",
			"gateText",
			"gateBtn",
			"navHome",
			"navAbout",
			"navSkills",
			"navExperience",
			"navProjects",
			"navEducation",
			"navContact",
			"hello",
			"name",
			"role",
			"heroBio",
			"ctaTouch",
			"ctaWork",
			"aboutTitle",
			"aboutHeadline",
			"aboutP1",
			"aboutP2",
			"aboutP3",
			"skillsTitle",
			"experienceTitle",
			"projectsTitle",
			"educationTitle",
			"contactTitle",
			"contactHeadline",
			"contactText",
			"contactEmailLabel",
			"contactPhoneLabel",
			"contactLinkedinLabel",
			"contactGithubLabel",
			"contactLocationLabel",
			"contactLocation",
			"contactPhone",
			"cvTitle",
			"cvEs",
			"cvEn",
			"cvEsAts",
			"cvEnAts",
			"footer",
		].forEach((key) => setText(key, t[key]));

		const skillsGrid = document.getElementById("skills-grid");
		if (skillsGrid) {
			skillsGrid.innerHTML = t.skillGroups
				.map(
					(group) => `<article class="skill-card">
						<h3>${group.title}</h3>
						<div class="pills">${group.items.map((item) => `<span>${item}</span>`).join("")}</div>
					</article>`,
				)
				.join("");
		}

		const jobs = document.getElementById("jobs");
		if (jobs) {
			jobs.innerHTML = t.jobs
				.map(
					(job) => `<article class="job-card">
						<div class="job-head">
							<div>
								<h3>${job.role}</h3>
								<p class="company">${job.company}</p>
							</div>
							<span class="dates">${job.dates}</span>
						</div>
						<p class="summary">${job.summary}</p>
						<ul>${job.bullets.map((b) => `<li>${b}</li>`).join("")}</ul>
					</article>`,
				)
				.join("");
		}

		const projects = document.getElementById("projects-grid");
		if (projects) {
			projects.innerHTML = t.projects
				.map(
					(project) => `<article class="project-card">
						<h3>${project.name}</h3>
						<p>${project.blurb}</p>
						<div class="tags">${project.tags.map((tag) => `<span>${tag}</span>`).join("")}</div>
						<a href="${project.href}" target="_blank" rel="noopener noreferrer">${project.cta}</a>
					</article>`,
				)
				.join("");
		}

		const education = document.getElementById("education-list");
		if (education) {
			education.innerHTML = t.education.map((item) => `<li>${item}</li>`).join("");
		}

		langButtons.forEach((btn) => {
			btn.classList.toggle("is-active", btn.getAttribute("data-lang") === lang);
		});
		document.documentElement.lang = lang;
		document.title = t.pageTitle;
		localStorage.setItem("portfolio-lang", lang);
	}

	function openSite() {
		if (!gate || !site) return;
		gate.classList.add("is-leaving");
		window.setTimeout(() => {
			gate.hidden = true;
			gate.classList.remove("is-leaving");
			site.hidden = false;
			site.classList.remove("is-hidden");
			sessionStorage.setItem("portfolio-entered", "1");
		}, 260);
	}

	window.__openPortfolio = openSite;

	enterBtn?.addEventListener("click", openSite);
	langButtons.forEach((btn) => {
		btn.addEventListener("click", () => render(btn.getAttribute("data-lang") || "en"));
	});

	render(localStorage.getItem("portfolio-lang") || "en");

	if (sessionStorage.getItem("portfolio-entered") === "1") {
		gate.hidden = true;
		site.hidden = false;
		site.classList.remove("is-hidden");
	}
</script>

